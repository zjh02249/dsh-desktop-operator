{
  "name": "dsh-desktop-operator",
  "description": "DSH Desktop Operator: safe Windows Computer Use, desktop automation, UI Automation, and MCP tools for DeepSeek Harness",
  "version": "0.10.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjh02249/dsh-desktop-operator.git"
  },
  "homepage": "https://github.com/zjh02249/dsh-desktop-operator#readme",
  "bugs": {
    "url": "https://github.com/zjh02249/dsh-desktop-operator/issues"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "computer-use",
    "mcp",
    "accessibility",
    "windows",
    "desktop-automation",
    "desktop-control",
    "desktop-operator",
    "ui-automation",
    "uiautomation",
    "window-management",
    "ai-agent",
    "codex"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "build:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-runtime.ps1",
    "package:plugin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-plugin.ps1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "runtime/**/*",
    "scripts/build-runtime.ps1",
    "scripts/package-plugin.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-user-approval": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-user-questions": ">=0.0.1-rc.1 <1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  }
}
